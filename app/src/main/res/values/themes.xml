    <style name="GlassCard">
        <item name="android:tag">glassCard</item>
        <item name="android:background">@drawable/glass_card</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>
    <style name="FieldLabel">
        <item name="android:textColor">?attr/nxTextMain</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="SectionTitle">
        <item name="android:textColor">?attr/nxTextDim</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginTop">0dp</item>
    </style>
    <style name="Selector">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/glass_field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">?attr/nxTextMain</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawableEnd">@drawable/ic_chevron</item>
        <item name="android:drawableTint">?attr/nxTextDim</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="Theme.AIAssistant.Amoled" parent="Theme.AIAssistant.Midnight">
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="colorSurface">#FF0B0B0F</item>
        <item name="nxBg">#FF000000</item>
        <item name="nxSurface">#FF0B0B0F</item>
        <item name="nxSheetBg">#FF08080C</item>
        <item name="nxCardFill">#FF0B0B0F</item>
        <item name="nxCardFillEnd">#FF08080C</item>
    </style>
</resources>
