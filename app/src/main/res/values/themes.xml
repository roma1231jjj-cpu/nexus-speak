    <style name="Theme.AIAssistant" parent="Theme.AIAssistant.Midnight" />

    <style name="Theme.AIAssistant.Assistant">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.AIAssistant.Midnight.Assistant" parent="Theme.AIAssistant.Midnight">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.AIAssistant.Frost.Assistant" parent="Theme.AIAssistant.Frost">
